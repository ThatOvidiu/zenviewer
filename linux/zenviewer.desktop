[Desktop Entry]
Type=Application
Name=ZenViewer
GenericName=Image Viewer
Comment=View images
Exec=zenviewer %f
Icon=zenviewer
Terminal=false
Categories=Graphics;Viewer;Qt;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/webp;image/tiff;image/svg+xml;image/svg+xml-compressed;image/x-icon;image/vnd.microsoft.icon;image/x-win-bitmap;image/x-icns;image/x-tga;image/vnd.wap.wbmp;image/x-mng;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-portable-anymap;image/x-xbitmap;image/x-xpixmap;
